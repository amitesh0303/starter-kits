# ─── Auth.js (required, server-only) ─────────────────────────────────────────
NEXTAUTH_SECRET=placeholder_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ─── Database (required, server-only) ───────────────────────────────────────────
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# ─── Stripe (required, server-only) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── Google Calendar (required, server-only) ─────────────────────────────────────
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder_google_secret
GOOGLE_REFRESH_TOKEN=placeholder_refresh_token

# ─── Resend (required, server-only) ─────────────────────────────────────────────
RESEND_API_KEY=re_placeholder

# ─── App (required, client-safe) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
