---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteConfig } from '../config';
---

<BaseLayout title="Contact | My Static Site" description="Get in touch via email.">
  <article class="contact-content">
    <h1>Contact</h1>
    <p>
      Have a question or want to get in touch? Send an email to the address below.
    </p>

    <p class="contact-email">
      <a href={`mailto:${SiteConfig.contactEmail}`}>{SiteConfig.contactEmail}</a>
    </p>

    <p class="contact-note">
      Replace the email address in <code>src/config.ts</code> with your own
      to make this link point to your inbox.
    </p>
  </article>
</BaseLayout>

<style>
  .contact-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .contact-email {
    font-size: 1.25rem;
    margin: 2rem 0;
  }

  .contact-email a {
    color: #1a5a9e;
    text-decoration: underline;
    padding: 0.75rem 1.5rem;
    border: 2px solid #1a5a9e;
    border-radius: 8px;
    display: inline-block;
    transition: background-color 0.2s, color 0.2s;
  }

  .contact-email a:hover {
    background-color: #1a5a9e;
    color: #ffffff;
  }

  .contact-email a:focus-visible {
    outline: 2px solid #1a5a9e;
    outline-offset: 4px;
  }

  .contact-note {
    color: #595959;
    font-size: 0.875rem;
  }

  code {
    background: #edf2f7;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.85em;
  }
</style>
