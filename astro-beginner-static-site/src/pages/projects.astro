---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

const projects = [
  {
    title: 'Project Alpha',
    description: 'A sample project demonstrating the Card component. Replace this with your own project details.',
  },
  {
    title: 'Project Beta',
    description: 'Another sample project. Add links, images, or extra details as you build out your portfolio.',
  },
  {
    title: 'Project Gamma',
    description: 'A third placeholder project. Delete or duplicate these cards to match your needs.',
  },
];
---

<BaseLayout title="Projects | My Static Site" description="A showcase of projects and work.">
  <article class="projects-content">
    <h1>Projects</h1>
    <p>Here are some of my projects. Edit the list in <code>src/pages/projects.astro</code> to showcase your own work.</p>

    <div class="project-grid">
      {projects.map((project) => (
        <Card title={project.title} description={project.description} />
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  .projects-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  code {
    background: #edf2f7;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
