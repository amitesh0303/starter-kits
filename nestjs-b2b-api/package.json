{
  "name": "nestjs-b2b-api",
  "version": "0.1.0",
  "description": "NestJS multi-tenant enterprise backend with Passport JWT, PostgreSQL/Prisma, Stripe, BullMQ, and Redis",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.0.3",
    "@nestjs/core": "11.0.3",
    "@nestjs/platform-express": "11.0.3",
    "@nestjs/passport": "11.0.3",
    "@nestjs/jwt": "11.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "@prisma/client": "6.2.1",
    "stripe": "17.5.0",
    "bullmq": "5.34.4",
    "ioredis": "5.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "class-validator": "0.14.1",
    "class-transformer": "0.5.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/testing": "11.0.3",
    "@types/node": "22.10.5",
    "@types/passport-jwt": "4.0.1",
    "@types/jest": "29.5.14",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.20.0",
    "typescript": "5.7.3",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "prisma": "6.2.1"
  }
}
