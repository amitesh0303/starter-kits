---
import type { PageMetadata } from '../seo/metadata';

export interface Props {
  metadata: PageMetadata;
  structuredData?: string;
}

const { metadata, structuredData } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    {structuredData && (
      <script type="application/ld+json" set:html={structuredData} />
    )}
  </head>
  <body>
    <!-- Consent banner placeholder -->
    <div id="consent-banner" class="consent-banner" hidden>
      <p>We use cookies for ads and analytics.</p>
      <button id="consent-accept" type="button">Accept</button>
      <button id="consent-reject" type="button">Reject</button>
    </div>

    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>

    <main>
      <slot name="top-ad" />
      <slot />
      <slot name="bottom-ad" />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Astro AdSense Blog</p>
    </footer>

    <!-- Consent and analytics script - only initializes when consent is granted -->
    <script>
      import { getConsent, setConsent } from '../lib/consent-store';
      import { initAnalytics } from '../analytics/index';

      // Show consent banner if no prior consent recorded
      const consent = getConsent();
      const banner = document.getElementById('consent-banner');
      const acceptBtn = document.getElementById('consent-accept');
      const rejectBtn = document.getElementById('consent-reject');

      if (!consent.updatedAt || consent.updatedAt === new Date(0).toISOString()) {
        banner?.removeAttribute('hidden');
      }

      acceptBtn?.addEventListener('click', () => {
        setConsent({ advertising: true, analytics: true });
        banner?.setAttribute('hidden', '');
        initAnalytics();
      });

      rejectBtn?.addEventListener('click', () => {
        setConsent({ advertising: false, analytics: false });
        banner?.setAttribute('hidden', '');
      });

      // Initialize analytics if consent already granted
      if (consent.analytics) {
        initAnalytics();
      }
    </script>
  </body>
</html>

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #333;
    color: #fff;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: 1000;
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  #consent-accept {
    background: #4caf50;
    color: white;
  }

  #consent-reject {
    background: #f44336;
    color: white;
  }
</style>
