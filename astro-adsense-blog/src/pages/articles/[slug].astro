---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ad from '../../components/Ad.astro';
import { generatePageMetadata } from '../../seo/metadata';
import { generateArticleJsonLd } from '../../seo/structured-data';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://example.com';
const canonicalUrl = `${siteUrl}/articles/${article.id}/`;

const isDraft = article.data.draft ?? false;
const isFuture = article.data.publishedAt > new Date();
const robots = isDraft || isFuture ? 'noindex, nofollow' : 'index, follow';

const metadata = generatePageMetadata({
  title: article.data.title,
  description: article.data.description,
  canonicalUrl,
  robots,
});

// Look up author name from authors collection
const authors = await getCollection('authors');
const authorEntry = authors.find((a) => a.data.slug === article.data.author);
const authorName = authorEntry?.data.name ?? article.data.author;

const structuredData = generateArticleJsonLd({
  title: article.data.title,
  description: article.data.description,
  publishedAt: article.data.publishedAt.toISOString(),
  updatedAt: article.data.updatedAt?.toISOString(),
  authorName,
  canonicalUrl,
  image: article.data.image,
});
---

<BaseLayout metadata={metadata} structuredData={structuredData}>
  <Ad slot="top-ad" />
  <article>
    <header>
      <h1>{article.data.title}</h1>
      <p class="article-meta">
        By <span class="author">{authorName}</span> |
        <time datetime={article.data.publishedAt.toISOString()}>
          {article.data.publishedAt.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {article.data.updatedAt && (
          <span>
            | Updated: <time datetime={article.data.updatedAt.toISOString()}>
              {article.data.updatedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </span>
        )}
      </p>
      <ul class="tag-list">
        {article.data.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
  <Ad slot="bottom-ad" />
</BaseLayout>

<style>
  article {
    max-width: 65ch;
    margin: 0 auto;
  }

  .article-meta {
    color: #4a4a4a;
    font-size: 0.875rem;
  }

  .author {
    font-weight: 600;
  }

  .tag-list {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .tag {
    background: #e8f4f8;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
    color: #004d99;
  }

  .content {
    line-height: 1.7;
  }
</style>
