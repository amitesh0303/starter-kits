---
/**
 * Responsive reserved-space Ad component.
 * Reserves exact dimensions by viewport BEFORE any AdSense script loads.
 * When ads are blocked/delayed/unavailable/consent-withheld, the reserved space remains unchanged.
 *
 * Dimensions:
 * - Mobile (< 468px): 320x100
 * - Tablet (468px - 727px): 468x60
 * - Desktop (>= 728px): 728x90
 */
export interface Props {
  slot?: string;
  class?: string;
}

const { slot = 'auto', class: className = '' } = Astro.props;
---

<div
  class:list={['ad-container', className]}
  data-ad-slot={slot}
  aria-hidden="true"
  role="complementary"
  aria-label="Advertisement"
>
  <div class="ad-placeholder">
    <span class="ad-label">Advertisement</span>
  </div>
</div>

<style>
  .ad-container {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    overflow: hidden;
    margin: 1rem auto;
    box-sizing: border-box;

    /* Mobile default: 320x100 */
    min-width: 320px;
    min-height: 100px;
    width: 320px;
    height: 100px;
  }

  /* Tablet: 468x60 */
  @media (min-width: 468px) {
    .ad-container {
      min-width: 468px;
      min-height: 60px;
      width: 468px;
      height: 60px;
    }
  }

  /* Desktop: 728x90 */
  @media (min-width: 728px) {
    .ad-container {
      min-width: 728px;
      min-height: 90px;
      width: 728px;
      height: 90px;
    }
  }

  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .ad-label {
    color: #444444;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>

<script>
  import { getConsent, subscribeConsent } from '../lib/consent-store';
  import { loadConfig } from '../lib/config';

  function loadAds(): void {
    const consent = getConsent();
    const config = loadConfig();
    if (!consent.advertising || !config.isAdsenseEnabled) return;

    const containers = document.querySelectorAll<HTMLElement>('.ad-container');
    containers.forEach((container) => {
      // Mark container as consent-granted for ad provider initialization
      container.dataset.consentGranted = 'true';
    });
  }

  // Initial check
  loadAds();

  // React to consent changes
  subscribeConsent((state) => {
    if (state.advertising) {
      loadAds();
    }
  });
</script>
