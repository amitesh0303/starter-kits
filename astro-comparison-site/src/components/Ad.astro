---
export interface Props {
  slot?: string;
  class?: string;
}

const { slot = 'auto', class: className = '' } = Astro.props;
---

<div
  class:list={['ad-container', className]}
  data-ad-slot={slot}
  aria-hidden="true"
  role="complementary"
  aria-label="Advertisement"
>
  <div class="ad-placeholder">
    <span class="ad-label">Advertisement</span>
  </div>
</div>

<style>
  .ad-container {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    margin: 1rem auto;
    min-width: 320px;
    min-height: 100px;
    width: 320px;
    height: 100px;
  }

  @media (min-width: 728px) {
    .ad-container {
      min-width: 728px;
      min-height: 90px;
      width: 728px;
      height: 90px;
    }
  }

  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .ad-label {
    color: #444444;
    font-size: 0.75rem;
    text-transform: uppercase;
  }
</style>
