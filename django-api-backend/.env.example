# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_fake_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_fake_placeholder
STRIPE_FAKE_MODE=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
