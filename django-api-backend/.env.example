# Django settings
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) - defaults to SQLite if not set
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
