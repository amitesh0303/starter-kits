# ─── Auth0 (required, server-only) ───────────────────────────────────────────────
AUTH0_SECRET=placeholder_auth0_secret
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://placeholder.auth0.com
AUTH0_CLIENT_ID=placeholder_client_id
AUTH0_CLIENT_SECRET=placeholder_client_secret

# ─── Database (required, server-only) ───────────────────────────────────────────
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# ─── Paddle (required, server-only) ─────────────────────────────────────────────
PADDLE_API_KEY=pdl_placeholder
PADDLE_WEBHOOK_SECRET=pdl_whsec_placeholder

# ─── Postmark (required, server-only) ───────────────────────────────────────────
POSTMARK_API_KEY=pm_placeholder

# ─── App (required, client-safe) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
