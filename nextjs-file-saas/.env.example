# ─── Clerk (required, server + client) ───────────────────────────────────────
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# ─── Database (required, server-only) ───────────────────────────────────────────
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# ─── Stripe (required, server-only) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── Inngest (required, server-only) ────────────────────────────────────────────
INNGEST_EVENT_KEY=placeholder_inngest_event_key
INNGEST_SIGNING_KEY=placeholder_inngest_signing_key

# ─── Cloudflare R2 (required, server-only) ──────────────────────────────────────
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=placeholder-bucket
R2_PUBLIC_URL=https://placeholder.r2.dev

# ─── App (required, client-safe) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
