# ==============================================================================
# Expo Subscription App - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in values for your environment.
# In development/fake mode, all adapters use built-in fake implementations.
# ==============================================================================

# --- Supabase ---
# Classification: Client-safe (anon key is row-level-security restricted)
# Required for real mode; if missing, fake auth adapter is used
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Service Role Key ---
# Classification: SERVER-ONLY - NEVER embed in client bundle
# Only used in server-side/Edge Functions; not consumed by the mobile app
# SUPABASE_SERVICE_ROLE_KEY=

# --- RevenueCat ---
# Classification: Client-safe (public API key, not shared secret)
# Required for real mode; if missing, fake purchase adapter is used
EXPO_PUBLIC_REVENUECAT_API_KEY=

# --- Sentry ---
# Classification: Client-safe (DSN is public, rate-limited by Sentry)
# Optional; if missing, error reporting is disabled (fake reporter used)
EXPO_PUBLIC_SENTRY_DSN=

# --- Queue Configuration ---
# Classification: Client-safe (local config only)
# Optional; defaults to 50 if not set
QUEUE_CAPACITY=50
