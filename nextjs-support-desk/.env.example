# ─── Auth.js (required, server-only) ─────────────────────────────────────────
NEXTAUTH_SECRET=placeholder_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ─── Database (required, server-only) ───────────────────────────────────────────
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# ─── Resend (required, server-only) ─────────────────────────────────────────────
RESEND_API_KEY=re_placeholder

# ─── Cloudflare R2 (required, server-only) ──────────────────────────────────────
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=placeholder_bucket
R2_PUBLIC_URL=https://pub-placeholder.r2.dev

# ─── App (required, client-safe) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
