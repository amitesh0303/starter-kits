generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]
  tickets   Ticket[]
}

model Agent {
  id        String    @id @default(cuid())
  teamId    String
  userId    String    @unique
  email     String
  name      String
  role      AgentRole @default(agent)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tickets   Ticket[]  @relation("AssignedAgent")

  @@index([teamId])
}

model Ticket {
  id              String         @id @default(cuid())
  teamId          String
  customerId      String
  customerEmail   String
  customerName    String
  subject         String
  status          TicketStatus   @default(open)
  priority        TicketPriority @default(medium)
  assignedAgentId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedAgent   Agent?         @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([teamId, status])
  @@index([customerId])
  @@index([assignedAgentId])
}

model Message {
  id          String      @id @default(cuid())
  ticketId    String
  authorId    String
  authorType  AuthorType
  content     String
  createdAt   DateTime    @default(now())
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  fileKey   String   @unique
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum AgentRole {
  admin
  agent
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum AuthorType {
  customer
  agent
}
